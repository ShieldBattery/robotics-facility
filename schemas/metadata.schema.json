{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shieldbattery:robotics-facility:metadata:v1",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "description": "Canonical HTTPS Git URL ending in .git, without credentials, query, or fragment; tools/validate.mjs also enforces URL semantics."
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^patches/[a-z][a-z0-9-]*/[a-z0-9][a-z0-9-]*\\.patch$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": ["path", "sha256"]
          }
        }
      },
      "required": ["id", "repository", "revision"]
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              }
            },
            "required": ["name"]
          },
          "minItems": 1
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "playStyleTags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cheese",
              "timing-attack",
              "macro",
              "defensive",
              "aggressive",
              "harassment",
              "micro-heavy",
              "drops",
              "air-focused",
              "bio",
              "mech",
              "varied-openings",
              "reactive"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "humanSkill": {
          "enum": ["uncalibrated"]
        },
        "externalRatings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "rating": {
                "type": "number"
              },
              "observedOn": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "ratedVersion": {
                "type": ["string", "null"]
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "entry",
              "rating",
              "observedOn",
              "ratedVersion",
              "sourceUrl",
              "notes"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "authors",
        "homepage",
        "sourceUrl",
        "playStyleTags",
        "humanSkill",
        "externalRatings"
      ]
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": ["one-v-one", "teams", "free-for-all"]
        },
        "support": {
          "enum": ["verified", "experimental", "incompatible", "unverified"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "support", "notes"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectableRaces": {
          "type": "array",
          "items": {
            "enum": ["zerg", "terran", "protoss"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "randomRace": {
          "enum": ["supported", "unsupported", "unverified"]
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/format"
          },
          "minItems": 1
        },
        "mapConstraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["persistent", "none", "unknown"]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "notes"]
        }
      },
      "required": ["selectableRaces", "randomRace", "formats", "mapConstraints", "learning"]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["unreviewed", "approved", "restricted", "denied"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status", "evidence"]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localDistribution": {
          "$ref": "#/$defs/eligibility"
        },
        "publicCompetition": {
          "$ref": "#/$defs/eligibility"
        }
      },
      "required": ["localDistribution", "publicCompetition"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "bot": {
          "$ref": "#/$defs/bot"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sourceId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["name", "sourceId", "path", "notes"]
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["unverified", "prototype-tested"]
            },
            "bwapiVersion": {
              "const": "4.4.0"
            },
            "protocol": {
              "const": 10003
            },
            "botArchitecture": {
              "enum": ["x86", "x86_64"]
            },
            "gameArchitectures": {
              "type": "array",
              "items": {
                "enum": ["x86", "x86_64"]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "bwapiVersion",
            "protocol",
            "botArchitecture",
            "gameArchitectures",
            "evidence",
            "limitations"
          ]
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["recipe-in-shieldbattery", "recipe-in-robotics-facility"]
            },
            "repository": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "instructions": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
            }
          },
          "required": ["status", "repository", "revision", "instructions"]
        },
        "sourceReview": {
          "$ref": "#/$defs/sourceReview"
        }
      },
      "required": [
        "schemaVersion",
        "bot",
        "sourceIds",
        "profile",
        "license",
        "permissions",
        "compatibility",
        "build",
        "sourceReview"
      ]
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "native"
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "java"
            },
            "major": {
              "type": "integer",
              "minimum": 1
            },
            "architecture": {
              "enum": ["x86", "x86_64"]
            },
            "jvmArguments": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Arguments passed to Java before -jar; launch.arguments are passed to the bot afterward."
            }
          },
          "required": ["kind", "major", "architecture"]
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "botId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": {
              "const": "windows"
            },
            "architecture": {
              "enum": ["x86", "x86_64"]
            }
          },
          "required": ["os", "architecture"]
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entrypoint": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "workingDirectory": {
              "anyOf": [
                {
                  "const": "."
                },
                {
                  "type": "string",
                  "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
                }
              ]
            }
          },
          "required": ["entrypoint", "arguments", "workingDirectory"]
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "bwapi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            },
            "minimumBridgeVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["version", "protocol", "minimumBridgeVersion"]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "noticePath": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
              }
            },
            "required": ["name", "noticePath"]
          },
          "minItems": 1
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modifier": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": ["bot", "dependency"]
              }
            },
            "required": ["modifier", "date", "summary", "scope"]
          }
        },
        "writableDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
          },
          "minItems": 0
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipeSource": {
              "$ref": "#/$defs/source"
            },
            "recipePath": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!/)[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$"
            },
            "toolchain": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["recipeSource", "recipePath", "toolchain"]
        },
        "sourceReview": {
          "$ref": "#/$defs/sourceReview"
        }
      },
      "required": [
        "schemaVersion",
        "botId",
        "releaseId",
        "version",
        "platform",
        "runtime",
        "launch",
        "profile",
        "bwapi",
        "sources",
        "licenses",
        "permissions",
        "writableDirectories",
        "build",
        "sourceReview"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "zip"
        }
      },
      "required": ["url", "sha256", "sizeBytes", "manifestSha256", "format"]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "bots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bot": {
                "$ref": "#/$defs/bot"
              },
              "releases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "package": {
                      "$ref": "#/$defs/package"
                    },
                    "artifact": {
                      "$ref": "#/$defs/artifact"
                    }
                  },
                  "required": ["package", "artifact"]
                },
                "minItems": 1
              }
            },
            "required": ["bot", "releases"]
          },
          "minItems": 0
        }
      },
      "required": ["schemaVersion", "revision", "bots"]
    },
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        }
      },
      "required": ["schemaVersion", "sources"]
    },
    "sourceReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status", "evidence"]
    }
  }
}

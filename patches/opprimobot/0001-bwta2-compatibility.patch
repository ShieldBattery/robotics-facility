diff --git a/SCProjects/OpprimoBot/Source/Utils/PolygonUtils.h b/SCProjects/OpprimoBot/Source/Utils/PolygonUtils.h
new file mode 100644
index 0000000..72a248e
--- /dev/null
+++ b/SCProjects/OpprimoBot/Source/Utils/PolygonUtils.h
@@ -0,0 +1,53 @@
+#ifndef __POLYGON_UTILS_H__
+#define __POLYGON_UTILS_H__
+
+#include <set>
+#include <BWTA.h>
+#include <cstdint>
+
+namespace PolygonUtils
+{
+	inline bool pointOnSegment(const BWAPI::Position& point, const BWAPI::Position& a,
+		const BWAPI::Position& b)
+	{
+		const int64_t cross = int64_t(b.x - a.x) * (point.y - a.y)
+			- int64_t(b.y - a.y) * (point.x - a.x);
+		return cross == 0
+			&& point.x >= (a.x < b.x ? a.x : b.x)
+			&& point.x <= (a.x > b.x ? a.x : b.x)
+			&& point.y >= (a.y < b.y ? a.y : b.y)
+			&& point.y <= (a.y > b.y ? a.y : b.y);
+	}
+
+	// Polygon edges are inside so region membership does not flicker on a shared boundary.
+	inline bool contains(const BWTA::Polygon& polygon, const BWAPI::Position& point)
+	{
+		if (polygon.size() < 3)
+		{
+			return false;
+		}
+
+		bool inside = false;
+		for (size_t i = 0, previous = polygon.size() - 1; i < polygon.size(); previous = i++)
+		{
+			const BWAPI::Position& a = polygon[previous];
+			const BWAPI::Position& b = polygon[i];
+			if (pointOnSegment(point, a, b))
+			{
+				return true;
+			}
+			if ((a.y > point.y) != (b.y > point.y))
+			{
+				const int64_t left = int64_t(point.x - a.x) * (b.y - a.y);
+				const int64_t right = int64_t(b.x - a.x) * (point.y - a.y);
+				if ((b.y > a.y && left < right) || (b.y < a.y && left > right))
+				{
+					inside = !inside;
+				}
+			}
+		}
+		return inside;
+	}
+}
+
+#endif

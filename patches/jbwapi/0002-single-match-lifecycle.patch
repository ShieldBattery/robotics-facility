+        return reconnectUntil(deadline);
+    }
+
+    boolean reconnectUntil(final long deadline) {
+        while (!Thread.currentThread().isInterrupted()) {
+            if (connect()) {
+                return true;
+            }
+            if (deadline != Long.MAX_VALUE && System.nanoTime() >= deadline) {
+                return false;
+            }
+            try {

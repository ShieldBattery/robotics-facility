diff --git a/tests/RuntimeStateCodecTest.java b/tests/RuntimeStateCodecTest.java
new file mode 100644
index 000000000..311e007eb
--- /dev/null
+++ b/tests/RuntimeStateCodecTest.java
@@ -0,0 +1,54 @@
+import Lifecycle.Configure.RuntimeStateCodec;
+
+// Created by ShieldBattery on 2026-09-22.
+
+public final class RuntimeStateCodecTest {
+    public static void main(String[] args) {
+        assertFilename("Opponent/..\\%:CON", "%2F", "%2E%2E", "%5C", "%25", "%3A");
+        assertFilename(".", "%2E");
+        assertFilename("%2E", "%252E");
+        assertFilename("CON", "%43ON");
+        assertFilename("AUX", "%41UX");
+        assertFilename("PRN", "%50RN");
+        assertFilename("NUL", "%4EUL");
+        assertFilename("COM1", "%43OM1");
+        assertFilename("LPT1", "%4CPT1");
+        assertFilename("", "");
+        assertFilename("\u732B,Name\n", "%E7%8C%AB", "%2C", "%0A");
+        assertHistoryCell("Fighting Spirit, \u732B\r\n");
+        assertHistoryCell(" Name ");
+        assertHistoryCell(" ");
+        assertHistoryCell("Opponent/..\\%:CON");
+        assertInvalidHistoryCell("%");
+        assertInvalidHistoryCell("%0");
+        assertInvalidHistoryCell("%ZZ");
+    }
+
+    private static void assertFilename(String input, String... requiredFragments) {
+        final String encoded = RuntimeStateCodec.encodeFilenameComponent(input);
+        if (encoded.contains("/") || encoded.contains("\\") || encoded.contains(":")) {
+            throw new AssertionError(encoded);
+        }
+        for (String requiredFragment : requiredFragments) {
+            if (!encoded.contains(requiredFragment)) {
+                throw new AssertionError(encoded);
+            }
+        }
+    }
+
+    private static void assertHistoryCell(String input) {
+        final String encoded = RuntimeStateCodec.encodeHistoryCell(input);
+        final String decoded = RuntimeStateCodec.decodeHistoryCell(encoded.trim());
+        if (!input.equals(decoded) || encoded.contains(",") || encoded.contains("\r") || encoded.contains("\n")) {
+            throw new AssertionError(encoded);
+        }
+    }
+
+    private static void assertInvalidHistoryCell(String input) {
+        try {
+            RuntimeStateCodec.decodeHistoryCell(input);
+            throw new AssertionError(input);
+        } catch (IllegalArgumentException expected) {
+        }
+    }
+}

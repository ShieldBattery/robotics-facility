diff --git a/src/Lifecycle/Configure/RuntimeStateCodec.java b/src/Lifecycle/Configure/RuntimeStateCodec.java
new file mode 100644
index 000000000..ec5b8cfa6
--- /dev/null
+++ b/src/Lifecycle/Configure/RuntimeStateCodec.java
@@ -0,0 +1,67 @@
+package Lifecycle.Configure;
+
+import java.nio.charset.StandardCharsets;
+
+/** Modified by ShieldBattery on 2026-09-22. Encodes external game values before they become filenames or CSV cells. */
+public final class RuntimeStateCodec {
+    private RuntimeStateCodec() {}
+
+    public static String encodeFilenameComponent(String value) {
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        final StringBuilder encoded = new StringBuilder(bytes.length);
+        for (byte current : bytes) {
+            final int unsigned = Byte.toUnsignedInt(current);
+            if (isFilenameSafe(unsigned)) encoded.append((char) unsigned);
+            else appendPercentEncoded(encoded, unsigned);
+        }
+        if (isWindowsReservedName(encoded.toString())) encoded.replace(0, 1, percentEncoded(Byte.toUnsignedInt(bytes[0])));
+        return encoded.toString();
+    }
+
+    public static String encodeHistoryCell(String value) {
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        final StringBuilder encoded = new StringBuilder(bytes.length);
+        for (byte current : bytes) {
+            final int unsigned = Byte.toUnsignedInt(current);
+            if (isHistoryCellSafe(unsigned)) encoded.append((char) unsigned);
+            else appendPercentEncoded(encoded, unsigned);
+        }
+        return encoded.toString();
+    }
+
+    public static String decodeHistoryCell(String value) {
+        final byte[] decoded = new byte[value.length()];
+        int length = 0;
+        for (int index = 0; index < value.length(); index++) {
+            final char current = value.charAt(index);
+            if (current == '%') {
+                if (index + 2 >= value.length()) throw new IllegalArgumentException("Truncated percent encoding");
+                final int high = Character.digit(value.charAt(++index), 16);
+                final int low = Character.digit(value.charAt(++index), 16);
+                if (high < 0 || low < 0) throw new IllegalArgumentException("Invalid percent encoding");
+                decoded[length++] = (byte) ((high << 4) | low);
+            } else if (current <= 0x7f) decoded[length++] = (byte) current;
+            else throw new IllegalArgumentException("History cells must be ASCII encoded");
+        }
+        return new String(decoded, 0, length, StandardCharsets.UTF_8);
+    }
+
+    private static boolean isFilenameSafe(int value) {
+        return isAsciiLetterOrDigit(value) || value == '-' || value == '_';
+    }
+
+    private static boolean isHistoryCellSafe(int value) {
+        return isAsciiLetterOrDigit(value) || value == '-' || value == '_' || value == '.';
+    }
+
+    private static boolean isAsciiLetterOrDigit(int value) {
+        return value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' || value >= '0' && value <= '9';
+    }
+
+    private static boolean isWindowsReservedName(String value) {
+        return value.matches("(?i)CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]");
+    }
+
+    private static void appendPercentEncoded(StringBuilder output, int value) { output.append(percentEncoded(value)); }
+    private static String percentEncoded(int value) { return String.format("%%%02X", value); }
+}

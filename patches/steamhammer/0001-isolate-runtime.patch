-void openReadFile(std::ifstream & inFile, const std::string & filename)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include <atomic>
+#include <string>
+
+namespace
+{
+constexpr const char * WriteDir = "bwapi-data/write/";
+constexpr const char * ReadDir = "bwapi-data/read/";
+constexpr const char * PreparedDir = "bwapi-data/AI/prepared/";
+std::atomic<unsigned long> tempCounter{0};
+
+bool safeFilename(const std::string & name)
+{
+    if (name.empty() || name.size() > 128 || name == "." || name == "..")
+    {
+        return false;
+    }
+    for (unsigned char ch : name)
+    {
+        if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z') ||
+            (ch >= 'A' && ch <= 'Z') || ch == '_' || ch == '-' || ch == '.'))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Reject every reparse point on the relative path before touching learning data.
+bool safeDirectory(const char * directory, bool & exists)
+{
+    const DWORD root = GetFileAttributesA("bwapi-data");
+    if (root == INVALID_FILE_ATTRIBUTES || !(root & FILE_ATTRIBUTE_DIRECTORY) ||
+        (root & FILE_ATTRIBUTE_REPARSE_POINT))
+    {
+        exists = false;
+        return root == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND;
+    }
+    const DWORD attrs = GetFileAttributesA(directory);
+    exists = attrs != INVALID_FILE_ATTRIBUTES;
+    if (!exists)
+    {
+        return GetLastError() == ERROR_FILE_NOT_FOUND || GetLastError() == ERROR_PATH_NOT_FOUND;
+    }
+    if (!(attrs & FILE_ATTRIBUTE_DIRECTORY) || (attrs & FILE_ATTRIBUTE_REPARSE_POINT))
+    {
+        return false;
+    }
+    if (std::string(directory) == PreparedDir)
+    {
+        const DWORD ai = GetFileAttributesA("bwapi-data/AI");
+        return ai != INVALID_FILE_ATTRIBUTES && (ai & FILE_ATTRIBUTE_DIRECTORY) &&
+            !(ai & FILE_ATTRIBUTE_REPARSE_POINT);
+    }
+    return true;
+}
+
+LearningReadResult readAt(const char * directory, const std::string & filename,
+    std::string & contents)
+{
+    bool exists = false;
+    if (!safeDirectory(directory, exists))
+    {
+        return LearningReadResult::Rejected;
+    }
+    if (!exists)
+    {
+        return LearningReadResult::Missing;
+    }
+    const std::string path = std::string(directory) + filename;
+    HANDLE file = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
+        OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        const DWORD error = GetLastError();
+        return error == ERROR_FILE_NOT_FOUND ? LearningReadResult::Missing :
+            LearningReadResult::Rejected;
+    }
+    BY_HANDLE_FILE_INFORMATION info{};
+    if (!GetFileInformationByHandle(file, &info) ||
+        (info.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) ||
+        info.nFileSizeHigh != 0 || info.nFileSizeLow > MaxLearningFileBytes)
+    {
+        CloseHandle(file);
+        return LearningReadResult::Rejected;
+    }
+    std::string data;
+    data.resize(info.nFileSizeLow);
+    size_t offset = 0;
+    while (offset < data.size())
+    {
+        DWORD count = 0;
+        if (!ReadFile(file, &data[offset], static_cast<DWORD>(data.size() - offset),
+            &count, nullptr) || count == 0)
+        {
+            CloseHandle(file);
+            return LearningReadResult::Rejected;
+        }
+        offset += count;
+    }
+    LARGE_INTEGER size{};
+    const bool unchanged = GetFileSizeEx(file, &size) &&
+        size.QuadPart == static_cast<LONGLONG>(data.size());
+    CloseHandle(file);
+    if (!unchanged)
+    {
+        return LearningReadResult::Rejected;
+    }
+    // std::ifstream text mode translated CRLF before the parsers saw it.
+    std::string text;
+    text.reserve(data.size());
+    for (size_t i = 0; i < data.size(); ++i)
+    {
+        if (data[i] != '\r' || i + 1 == data.size() || data[i + 1] != '\n')
+        {
+            text += data[i];
+        }
+    }
+    contents.swap(text);
+    return LearningReadResult::Loaded;
+}
+
+bool safeExistingTarget(const std::string & path)
+{
+    const DWORD attrs = GetFileAttributesA(path.c_str());
+    if (attrs == INVALID_FILE_ATTRIBUTES)
+    {
+        return GetLastError() == ERROR_FILE_NOT_FOUND;
+    }
+    return !(attrs & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY));
+}
+}
+
+LearningReadResult readLearningFile(const std::string & filename, std::string & contents)
+{
+    contents.clear();
+    if (!safeFilename(filename))
+    {
+        return LearningReadResult::Rejected;
+    }
+    for (const char * directory : {WriteDir, ReadDir, PreparedDir})
+    {
+        const auto result = readAt(directory, filename, contents);
+        if (result != LearningReadResult::Missing)
+        {
+            return result;
+        }
+    }
+    return LearningReadResult::Missing;
+}
+
+bool writeLearningFile(const std::string & filename, const std::string & contents)
 {
-	inFile.open(Config::IO::ReadDir + filename, std::ios::in);
-
-	// There may not be a file to read. Check for a prepared file in the AI directory.
-	if (!inFile.good())
-	{
-		inFile.clear();
-		inFile.open(Config::IO::PreparedDataDir + filename, std::ios::in);
-	}
+    if (!safeFilename(filename) || contents.size() > MaxLearningFileBytes)
+    {
+        return false;
+    }
+    bool exists = false;
+    if (!safeDirectory(WriteDir, exists) || !exists)
+    {
+        return false;
+    }
+    const std::string target = std::string(WriteDir) + filename;
+    if (!safeExistingTarget(target))
+    {
+        return false;
+    }
+    const std::string temporary = target + ".tmp-" + std::to_string(GetCurrentProcessId()) +
+        "-" + std::to_string(GetTickCount64()) + "-" + std::to_string(++tempCounter);
+    HANDLE file = CreateFileA(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW,
+        FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        return false;
+    }
+    bool success = true;
+    size_t offset = 0;
+    while (offset < contents.size())
+    {
+        DWORD count = 0;
+        if (!WriteFile(file, contents.data() + offset,
+            static_cast<DWORD>(contents.size() - offset), &count, nullptr) || count == 0)
+        {
+            success = false;
+            break;
+        }
+        offset += count;
+    }
+    success = success && FlushFileBuffers(file);
+    CloseHandle(file);
+    if (success && safeDirectory(WriteDir, exists) && exists && safeExistingTarget(target))
+    {
+        success = MoveFileExA(temporary.c_str(), target.c_str(),
+            MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+    }
+    else
+    {
+        success = false;
+    }
+    if (!success)
+    {
+        DeleteFileA(temporary.c_str());
+    }
+    return success;
 }

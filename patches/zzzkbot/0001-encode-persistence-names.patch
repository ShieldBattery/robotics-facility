@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+// Copyright 2026 ShieldBattery contributors
+
+/*
+ * ShieldBattery modification, 2026-09-21.
+ *
+ * ZZZKBot persists player names in both file paths and tab-delimited history.
+ * These helpers retain ordinary ASCII names while encoding bytes that could
+ * change a path or a history record's structure.
+ */
+#ifndef ZZZKBOT_PERSISTENCE_ENCODING_H
+#define ZZZKBOT_PERSISTENCE_ENCODING_H
+
+#include <string>
+
+namespace ZZZKBotPersistence
+{
+    inline char hexDigit(unsigned char value)
+    {
+        return static_cast<char>(value < 10 ? '0' + value : 'A' + (value - 10));
+    }
+
+    inline void appendPercentEncodedByte(std::string& output, unsigned char value)
+    {
+        output += '%';
+        output += hexDigit(static_cast<unsigned char>(value >> 4));
+        output += hexDigit(static_cast<unsigned char>(value & 0x0f));
+    }
+
+    inline bool isSafeFilenameByte(unsigned char value)
+    {
+        return (value >= 'A' && value <= 'Z') ||
+            (value >= 'a' && value <= 'z') ||
+            (value >= '0' && value <= '9') ||
+            value == ' ' || value == '-' || value == '_' || value == '.';
+    }
+
+    inline bool equalsAsciiIgnoreCase(const std::string& value, std::size_t length, const char* expected)
+    {
+        for (std::size_t i = 0; i < length; ++i)
+        {
+            const unsigned char valueByte = static_cast<unsigned char>(value[i]);
+            const unsigned char expectedByte = static_cast<unsigned char>(expected[i]);
+            if (valueByte != expectedByte &&
+                !((valueByte | 0x20) == (expectedByte | 0x20) &&
+                    valueByte >= 'A' && valueByte <= 'z'))
+            {
+                return false;
+            }
+        }
+        return expected[length] == '\0';
+    }
+
+    inline bool isReservedWindowsDeviceName(const std::string& value)
+    {
+        std::size_t basenameLength = value.find('.');
+        if (basenameLength == std::string::npos)
+        {
+            basenameLength = value.size();
+        }
+        while (basenameLength != 0 && value[basenameLength - 1] == ' ')
+        {
+            --basenameLength;
+        }
+
+        if (basenameLength == 3 &&
+            (equalsAsciiIgnoreCase(value, basenameLength, "CON") ||
+                equalsAsciiIgnoreCase(value, basenameLength, "PRN") ||
+                equalsAsciiIgnoreCase(value, basenameLength, "AUX") ||
+                equalsAsciiIgnoreCase(value, basenameLength, "NUL")))
+        {
+            return true;
+        }
+
+        return basenameLength == 4 &&
+            ((equalsAsciiIgnoreCase(value, 3, "COM") || equalsAsciiIgnoreCase(value, 3, "LPT")) &&
+                value[3] >= '1' && value[3] <= '9');
+    }
+
+    inline std::string encodeFilenameComponent(const std::string& value)
+    {
+        std::string encoded;
+        encoded.reserve(value.size());
+        const bool startsWithReservedDeviceName = isReservedWindowsDeviceName(value);
+        for (std::size_t i = 0; i < value.size(); ++i)
+        {
+            const unsigned char byte = static_cast<unsigned char>(value[i]);
+            if (isSafeFilenameByte(byte) && !(startsWithReservedDeviceName && i == 0))
+            {
+                encoded += static_cast<char>(byte);
+            }
+            else
+            {
+                appendPercentEncodedByte(encoded, byte);
+            }
+        }
+        return encoded;
+    }
+
+    inline std::string escapeHistoryField(const std::string& value)
+    {
+        std::string escaped;
+        escaped.reserve(value.size());
+        for (unsigned char byte : value)
+        {
+            if (byte == '%' || byte == '\t' || byte == '\r' || byte == '\n' || byte == '\0')
+            {
+                appendPercentEncodedByte(escaped, byte);
+            }
+            else
+            {
+                escaped += static_cast<char>(byte);
+            }
+        }
+        return escaped;
+    }
+}
+
+#endif
